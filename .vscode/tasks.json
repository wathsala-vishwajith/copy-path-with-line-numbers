{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch",
            "dependsOn": [
                "pnpm: watch:tsc",
                "pnpm: watch:esbuild"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:esbuild",
            "group": "build",
            "isBackground": true,
            "label": "pnpm: watch:esbuild",
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                }
            },
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "pnpm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch-tests",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "pnpm: watch-tests",
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "group": "build"
        },
        {
            "label": "tasks: watch-tests",
            "dependsOn": [
                "watch",
                "pnpm: watch-tests"
            ],
            "problemMatcher": []
        }
    ]
}